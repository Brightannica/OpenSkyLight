# Database Connection URL
# Supports:
# - Supabase / PostgreSQL: postgresql://postgres:password@db.ref.supabase.co:5432/postgres
# - Turso / LibSQL: libsql://your-db-name.turso.io
# - Local SQLite file path: file:openskylight.db or openskylight.db
DATABASE_URL=file:openskylight.db

# Authentication Token for Turso / LibSQL (if using Turso)
LIBSQL_AUTH_TOKEN=

# Port for the Web HTTP API Server (default: 3000)
PORT=3000
